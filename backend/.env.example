# Backend runtime configuration (copy to backend/.env for local dev)

NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=zigbee
DB_PASSWORD=zigbee
DB_DATABASE=zigbee
# `true` lets TypeORM create/patch the schema on boot (fine for dev & first run)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# MQTT broker (Mosquitto)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=zigbee2mqtt
MQTT_CLIENT_ID=

# Retention / limits
MQTT_LOG_RETENTION_HOURS=48
MQTT_LOG_MAX_ROWS=200000
HISTORY_RETENTION_DAYS=90
DEVICE_OFFLINE_TIMEOUT_MINUTES=60

# Alert thresholds
ALERT_LOW_BATTERY_PERCENT=20
ALERT_HIGH_TEMPERATURE_C=40

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
AUTH_ENABLED=true
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin123
