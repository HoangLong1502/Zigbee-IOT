# ---------------------------------------------------------------------------
# Copy to .env and adjust. Used by docker-compose.yml.
# ---------------------------------------------------------------------------

# PostgreSQL
DB_USERNAME=zigbee
DB_PASSWORD=zigbee
DB_DATABASE=zigbee
DB_PORT=5432

# MQTT / Zigbee2MQTT
MQTT_BASE_TOPIC=zigbee2mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# Zigbee USB coordinator device node (Linux only - Docker Desktop on Windows
# cannot pass through COM ports, run Zigbee2MQTT natively instead).
ZIGBEE_ADAPTER=/dev/ttyUSB0

# Backend
JWT_SECRET=change-me-in-production
CORS_ORIGIN=*
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin123

TZ=UTC
