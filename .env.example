# ---------------------------------------------------------------------------
# Copy to .env and adjust. Used by docker-compose.yml.
# ---------------------------------------------------------------------------

# PostgreSQL
DB_USERNAME=zigbee
DB_PASSWORD=zigbee
DB_DATABASE=zigbee
DB_PORT=5432

# MQTT / Zigbee2MQTT
MQTT_BASE_TOPIC=zigbee2mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional Linux Docker profile: host USB coordinator device node.
# Native cross-platform mode uses auto-detection (npm run zigbee:start).
ZIGBEE_DEVICE=/dev/ttyUSB0

# Optional native launcher overrides:
# ZIGBEE_PORT=COM5
# ZIGBEE_ADAPTER=ember
# ZIGBEE_BAUD=115200

# Backend
JWT_SECRET=change-me-in-production
CORS_ORIGIN=*
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin123

TZ=UTC
